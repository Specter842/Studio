# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# NOTHING in this file is required for Phase 1 (local clips + local audio only).
# Every key below belongs to an optional, opt-in adapter.

# --- Binaries -------------------------------------------------------------
# Only set these if ffmpeg/ffprobe are not on your PATH.
FFMPEG_BIN=
FFPROBE_BIN=

# --- Phase 2: free stock footage (both have free tiers, no card required) --
PEXELS_API_KEY=your_pexels_key_here
PIXABAY_API_KEY=your_pixabay_key_here

# --- Phase 2: local ComfyUI (free, self-hosted; the default generator) -----
# Leave blank to use comfyui.host from config/settings.yaml
# (http://127.0.0.1:8188). Set it only to override that, e.g. a different port
# or a ComfyUI on another machine. A value here wins over settings.yaml.
COMFYUI_HOST=

# --- Phase 2: PAID gateway. Ignored unless paid_adapters_enabled: true -----
FAL_KEY=your_fal_key_here

# --- Phase 3: PAID avatars. Ignored unless paid_adapters_enabled: true -----
HEYGEN_API_KEY=your_heygen_key_here
