{
  "name": "video_pipeline — render queue",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "b1a2c3d4-0001-4000-8000-000000000001",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-660, 300]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "PUT_YOUR_GOOGLE_SHEET_ID_HERE",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Jobs",
          "mode": "name"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "status",
              "lookupValue": ""
            }
          ]
        },
        "options": {}
      },
      "id": "b1a2c3d4-0002-4000-8000-000000000002",
      "name": "Read pending jobs",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8712/render",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ audio: $json.audio, clips: $json.clips || null, brief: $json.brief || '', title: $json.title || '', out: $json.out || null, duration: $json.duration ? Number($json.duration) : null, seed: $json.seed ? Number($json.seed) : null, stock_per_query: $json.stock_per_query ? Number($json.stock_per_query) : null, generate: $json.generate ? Number($json.generate) : null, verify: true, wait: true }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 3600000
        }
      },
      "id": "b1a2c3d4-0003-4000-8000-000000000003",
      "name": "Trigger render",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-200, 300],
      "notes": "wait:true blocks until the render finishes, so the sheet is only updated once there is a real result. timeout is 60 min to match the orchestrator's own ceiling."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-succeeded",
              "leftValue": "={{ $json.status }}",
              "rightValue": "succeeded",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1a2c3d4-0004-4000-8000-000000000004",
      "name": "Rendered OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [40, 300]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "PUT_YOUR_GOOGLE_SHEET_ID_HERE",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Jobs",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "row_number": "={{ $('Read pending jobs').item.json.row_number }}",
            "status": "done",
            "output": "={{ $json.out }}",
            "job_id": "={{ $json.job_id }}"
          },
          "matchingColumns": ["row_number"]
        },
        "options": {}
      },
      "id": "b1a2c3d4-0005-4000-8000-000000000005",
      "name": "Mark done",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [280, 200]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "PUT_YOUR_GOOGLE_SHEET_ID_HERE",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Jobs",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "row_number": "={{ $('Read pending jobs').item.json.row_number }}",
            "status": "failed",
            "output": "={{ $json.error }}{{ $json.log_tail ? ' | ' + $json.log_tail : '' }}"
          },
          "matchingColumns": ["row_number"]
        },
        "options": {}
      },
      "id": "b1a2c3d4-0006-4000-8000-000000000006",
      "name": "Mark failed",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [280, 400]
    },
    {
      "parameters": {
        "path": "=/absolute/path/to/video_pipeline/inputs/jobs",
        "triggerOn": "folder",
        "events": ["add"],
        "options": {}
      },
      "id": "b1a2c3d4-0007-4000-8000-000000000007",
      "name": "Or: watch a folder",
      "type": "n8n-nodes-base.localFileTrigger",
      "typeVersion": 1,
      "position": [-660, 540],
      "disabled": true,
      "notes": "Alternative trigger. Enable this and disable the schedule + Sheets path if you would rather drop a job JSON into a folder. Feed it into 'Read job file' below."
    },
    {
      "parameters": {
        "fileSelector": "={{ $json.path }}",
        "options": {}
      },
      "id": "b1a2c3d4-0008-4000-8000-000000000008",
      "name": "Read job file",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [-440, 540],
      "disabled": true
    },
    {
      "parameters": {
        "operation": "fromJson",
        "options": {}
      },
      "id": "b1a2c3d4-0009-4000-8000-000000000009",
      "name": "Parse job JSON",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [-200, 540],
      "disabled": true,
      "notes": "Connect this to 'Trigger render' to use the folder path instead of Google Sheets."
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [[{ "node": "Read pending jobs", "type": "main", "index": 0 }]]
    },
    "Read pending jobs": {
      "main": [[{ "node": "Trigger render", "type": "main", "index": 0 }]]
    },
    "Trigger render": {
      "main": [[{ "node": "Rendered OK?", "type": "main", "index": 0 }]]
    },
    "Rendered OK?": {
      "main": [
        [{ "node": "Mark done", "type": "main", "index": 0 }],
        [{ "node": "Mark failed", "type": "main", "index": 0 }]
      ]
    },
    "Or: watch a folder": {
      "main": [[{ "node": "Read job file", "type": "main", "index": 0 }]]
    },
    "Read job file": {
      "main": [[{ "node": "Parse job JSON", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "instanceId": "video-pipeline-orchestration"
  },
  "tags": []
}
